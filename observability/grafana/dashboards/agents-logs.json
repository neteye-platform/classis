{
  "uid": "opamp-agents-logs",
  "title": "Fleet Agents \u2014 Logs",
  "description": "The Client's own log output, as OTLP log records.",
  "tags": [
    "opamp",
    "clickhouse"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "description": "The Client's service.name.",
        "query": {
          "refId": "tempvar",
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.20.0",
          "rawSql": "SELECT DISTINCT ServiceName FROM otel.otel_logs ORDER BY 1"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "hide": 0
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "TRACE,DEBUG,INFO,WARN,ERROR",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "search",
        "label": "Contains",
        "type": "textbox",
        "query": "",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0,
        "description": "Case-insensitive substring of the log body. Empty matches everything."
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Lines in window",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.20.0",
          "rawSql": "SELECT count()\nFROM otel.otel_logs\nWHERE $__timeFilter(Timestamp)\n  AND match(ServiceName, '${service:regex}')\n  AND match(SeverityText, '${level:regex}')"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Errors in window",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.20.0",
          "rawSql": "SELECT countIf(SeverityText = 'ERROR')\nFROM otel.otel_logs\nWHERE $__timeFilter(Timestamp)\n  AND match(ServiceName, '${service:regex}')"
        }
      ],
      "description": "Not filtered by the level picker on purpose \u2014 an error count that hides when you filter to INFO would be worse than none.",
      "id": 2
    },
    {
      "type": "stat",
      "title": "Warnings in window",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.20.0",
          "rawSql": "SELECT countIf(SeverityText = 'WARN')\nFROM otel.otel_logs\nWHERE $__timeFilter(Timestamp)\n  AND match(ServiceName, '${service:regex}')"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Clients logging",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.20.0",
          "rawSql": "SELECT uniqExact(ResourceAttributes['service.instance.id'])\nFROM otel.otel_logs\nWHERE $__timeFilter(Timestamp)\n  AND match(ServiceName, '${service:regex}')"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Volume by level",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.20.0",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, SeverityText AS level, count() AS lines\nFROM otel.otel_logs\nWHERE $__timeFilter(Timestamp)\n  AND match(ServiceName, '${service:regex}')\n  AND match(SeverityText, '${level:regex}')\nGROUP BY time, level\nORDER BY time"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Volume by client",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.20.0",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time,\n       ResourceAttributes['service.instance.id'] AS agent,\n       count() AS lines\nFROM otel.otel_logs\nWHERE $__timeFilter(Timestamp)\n  AND match(ServiceName, '${service:regex}')\n  AND match(SeverityText, '${level:regex}')\nGROUP BY time, agent\nORDER BY time"
        }
      ],
      "id": 6
    },
    {
      "type": "logs",
      "title": "Log",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 14
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 2,
          "queryType": "logs",
          "pluginVersion": "4.20.0",
          "rawSql": "SELECT Timestamp AS timestamp,\n       Body AS body,\n       SeverityText AS level,\n       ServiceName AS service,\n       ResourceAttributes['service.instance.id'] AS agent,\n       LogAttributes['code.namespace'] AS target,\n       TraceId AS trace_id\nFROM otel.otel_logs\nWHERE $__timeFilter(Timestamp)\n  AND match(ServiceName, '${service:regex}')\n  AND match(SeverityText, '${level:regex}')\n  AND positionCaseInsensitive(Body, '${search}') > 0\nORDER BY Timestamp DESC\nLIMIT 1000"
        }
      ],
      "id": 7
    }
  ]
}
