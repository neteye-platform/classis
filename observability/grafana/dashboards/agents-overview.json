  "templating": {
    "list": [
      {
        "name": "client",
        "label": "Client type",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "description": "The Clients' service.name \u2014 one value per kind of Client, not per host.",
        "query": {
          "refId": "tempvar",
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.20.0",
          "rawSql": "SELECT DISTINCT ResourceAttributes['service.name'] FROM otel.otel_metrics_gauge ORDER BY 1"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Agent",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "description": "The Agent each sample is about, which is what separates a Managed Process from the Client that sampled it.",
        "query": {
          "refId": "tempvar",
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.20.0",
          "rawSql": "SELECT DISTINCT Attributes['service.instance.id'] FROM otel.otel_metrics_gauge ORDER BY 1"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "hide": 0
      },
      {
        "name": "platform",
        "label": "Platform",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "description": "The host an Agent runs on, as os.type/host.arch \u2014 the two halves ADR-0026 selects a package variant by.",
        "query": {
          "refId": "tempvar",
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.20.0",
          "rawSql": "SELECT DISTINCT concat(ResourceAttributes['os.type'], '/', ResourceAttributes['host.arch']) FROM otel.otel_metrics_gauge ORDER BY 1"
        },
