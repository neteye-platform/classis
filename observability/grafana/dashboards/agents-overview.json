          "rawSql": "SELECT Timestamp AS timestamp,\n       Body AS body,\n       SeverityText AS level,\n       ServiceName AS service,\n       TraceId AS trace_id,\n       LogAttributes['code.namespace'] AS target\nFROM otel.otel_logs\nWHERE $__timeFilter(Timestamp)\nORDER BY Timestamp DESC\nLIMIT 500"
