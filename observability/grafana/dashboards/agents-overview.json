      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.20.0",
          "rawSql": "SELECT Attributes['service.instance.id'] AS \"Agent\",\n       any(Attributes['service.instance.name']) AS \"Name\",\n       any(Attributes['service.name']) AS \"Type\",\n       any(ResourceAttributes['service.instance.name']) AS \"Client\",\n       any(ResourceAttributes['service.version']) AS \"Client version\",\n       any(ResourceAttributes['os.type']) AS \"OS\",\n       any(ResourceAttributes['host.arch']) AS \"Arch\",\n       argMaxIf(Value, TimeUnix, MetricName = 'process.memory.usage') AS \"Memory\",\n       argMaxIf(Value, TimeUnix, MetricName = 'process.cpu.utilization') AS \"CPU\",\n       argMaxIf(Value, TimeUnix, MetricName = 'process.uptime') AS \"Uptime\",\n       max(TimeUnix) AS \"Last sample\"\nFROM otel.otel_metrics_gauge\nWHERE $__timeFilter(TimeUnix)\n  AND match(ResourceAttributes['service.name'], '${client:regex}')\n  AND match(Attributes['service.instance.id'], '${instance:regex}')\n  AND match(concat(ResourceAttributes['os.type'], '/', ResourceAttributes['host.arch']), '${platform:regex}')\nGROUP BY \"Agent\"\nORDER BY \"Agent\""
        }
      ],
      "description": "All three metrics per Agent in one row, from the newest sample of each. Name and Type are the Agent's own; Client, Client version, OS and Arch describe the Client that sampled it and the host both run on.",
      "id": 11
    },
