      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.20.0",
          "rawSql": "SELECT $__timeInterval(TimeUnix) AS time,\n       Attributes['service.instance.id'] AS agent,\n       arrayStringConcat(arrayFilter(x -> x != '', [\n           Attributes['service.instance.name'],\n           Attributes['service.name'],\n           ResourceAttributes['os.type']]), ' \u00b7 ') AS label,\n       avg(Value) AS uptime\nFROM otel.otel_metrics_gauge\nWHERE MetricName = 'process.uptime' AND $__timeFilter(TimeUnix)\n  AND match(ResourceAttributes['service.name'], '${client:regex}')\n  AND match(Attributes['service.instance.id'], '${instance:regex}')\n  AND match(concat(ResourceAttributes['os.type'], '/', ResourceAttributes['host.arch']), '${platform:regex}')\nGROUP BY time, agent, label\nORDER BY time"
        }
