{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build",
      "type": "shell",
      "command": "cargo build --workspace",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo test",
      "type": "shell",
      "command": "cargo test --workspace",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      // Both launch configurations run on the development set of scripts/dev-pki.sh. It is made
      // once and kept; the lock keeps the two launches of "Server + Supervisor" from making it twice.
      "label": "dev pki",
      "type": "shell",
      "command": "flock /tmp/opamp-fleet-dev-pki.lock sh -c 'test -f .dev-pki/supervisor.toml || scripts/dev-pki.sh'",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    },
    {
      "label": "cargo lint",
      "type": "shell",
      "command": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
      "problemMatcher": ["$rustc"]
    }
  ]
}
