# Editor-neutral formatting baseline, read by every major editor and by most CLI formatters.
# .vscode/settings.json carries the same intent, but applies only inside VS Code — this file is
# what a coding agent, a different editor, or a formatter run from the command line sees.
#
# It states only what is toolchain-independent. Once a language is chosen, its own formatter is
# authoritative for that language's files: add a section here that agrees with the formatter's
# configuration rather than one that contends with it.
#
# Markdown prose wraps at 80 columns, as markdownlint's line-length rule checks
# (.markdownlint-cli2.yaml); `prettier --prose-wrap always --print-width 80` writes it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
max_line_length = 80
# Two trailing spaces are a hard line break in Markdown — trimming them changes the rendering.
trim_trailing_whitespace = false
